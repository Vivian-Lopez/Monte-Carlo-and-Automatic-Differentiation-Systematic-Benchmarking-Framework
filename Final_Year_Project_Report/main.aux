\@writefile{toc}{\contentsline {paragraph}{RQ1. How do different software stacks and execution backends affect the runtime, throughput, and memory behaviour of Monte Carlo workloads?}{54}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{RQ2. What are the performance and memory trade-offs of automatic differentiation for representative Monte Carlo option-pricing workloads?}{54}{section*.28}\protected@file@percent }
