\@writefile{toc}{\contentsline {paragraph}{RQ5. Can short probe runs and successive-halving style profiling reduce the cost of cloud benchmarking while still recovering near-Pareto-optimal configurations?}{54}{section*.31}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{RQ6. What are the practical limitations, threats to validity, and generalisation limits of this benchmarking methodology?}{54}{section*.32}\protected@file@percent }
